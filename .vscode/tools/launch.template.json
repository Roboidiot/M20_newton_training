{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Train M20NewtonTraining-M20-M20 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "module": "isaaclab",
            "args": [
                "train",
                "--rl_library", "rsl_rl",
                "--task", "M20NewtonTraining-M20-M20",
                "--num_envs", "4096"            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Play M20NewtonTraining-M20-M20 with rsl_rl (PPO)",
            "type": "debugpy",
            "request": "launch",
            "module": "isaaclab",
            "args": [
                "play",
                "--rl_library", "rsl_rl",
                "--task", "M20NewtonTraining-M20-M20",
                "--num_envs", "32"            ],
            "console": "integratedTerminal"
        },
    ]
}
