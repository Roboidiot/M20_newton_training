{
  "defaults": {
    "task": "M20NewtonTraining-M20-M20-WalkOnSandProxy",
    "physics": "newton_mjwarp",
    "num_envs": 2048,
    "max_iterations": 2000,
    "seed": 42,
    "logger": "tensorboard",
    "viz": "none",
    "checkpoint": "logs/rsl_rl/deeprobotics_m20_walk/2026-11-12_14-59-10/model_700.pt",
    "resume_optimizer_state": false,
    "reward_weights": {},
    "overrides": {}
  },
  "runs": [
    {
      "name": "proxy_baseline"
    },
    {
      "name": "proxy_no_orientation",
      "reward_weights": {
        "flat_orientation_l2": 0.0
      }
    },
    {
      "name": "proxy_strong_orientation",
      "reward_weights": {
        "flat_orientation_l2": -50.0
      }
    },
    {
      "name": "proxy_air_threshold_01",
      "overrides": {
        "env.rewards.feet_air_time.params.threshold": 0.1
      }
    },
    {
      "name": "proxy_air_threshold_05",
      "overrides": {
        "env.rewards.feet_air_time.params.threshold": 0.5
      }
    },
    {
      "name": "proxy_no_forward_step",
      "reward_weights": {
        "feet_forward_step": 0.0
      }
    },
    {
      "name": "proxy_strong_lift",
      "reward_weights": {
        "rotation_gait_status": 6.0
      }
    },
    {
      "name": "proxy_strong_phase",
      "reward_weights": {
        "rotation_gait_symmetry": 30.0
      }
    }
  ]
}
